<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="SensorScope"
        android:gravity="center"
        android:textColor="#10796E"
        android:textSize="40sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="start"
        android:text="Choose a Sensor"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/sensorGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:orientation="vertical" >

        <RadioButton
            android:id="@+id/radioAccelerometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#10796E"
            android:text="Accelerometer"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:paddingStart="12dp" />

        <RadioButton
            android:id="@+id/radioGyroscope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#10796E"
            android:text="Gyroscope"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:paddingStart="12dp" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/info_background"
        android:orientation="vertical" >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#AAE0DB"
            android:gravity="center"
            android:paddingStart="15dp"
            android:text="Sensor Information"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp" >

            <TextView
                android:id="@+id/tvAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Select a sensor"
                android:textColor="#272A2A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMaxRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Max Range: --"
                android:textColor="#272A2A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Resolution: --"
                android:textColor="#272A2A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMinDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Min Delay: --"
                android:textColor="#272A2A"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnStartSession"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="#10796E"
        android:text="START NEW SESSION"
        android:enabled="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>